{
  "name": "customer-hub-api",
  "version": "0.0.1",
  "private": true,
  "description": "Customer Hub API MVP backend",
  "scripts": {
    "build": "nest build",
    "deploy": "bash scripts/deploy.sh",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main",
    "test": "jest",
    "meta:ads-fields": "node scripts/export-meta-ads-fields.mjs",
    "meta:ads-samples": "node scripts/export-meta-ads-samples.mjs",
    "sendpulse:import": "ts-node -r tsconfig-paths/register src/scripts/import-sendpulse-audience.ts",
    "typeorm": "typeorm-ts-node-commonjs -d src/typeorm/data-source.ts",
    "typeorm:migration:generate": "typeorm-ts-node-commonjs -d src/typeorm/data-source.ts migration:generate",
    "typeorm:migration:run": "typeorm-ts-node-commonjs -d src/typeorm/data-source.ts migration:run",
    "typeorm:migration:revert": "typeorm-ts-node-commonjs -d src/typeorm/data-source.ts migration:revert"
  },
  "dependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "@nestjs/typeorm": "^11.0.0",
    "pg": "^8.13.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "typeorm": "^0.3.20"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.7",
    "jest": "^29.7.0",
    "source-map-support": "^0.5.21",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.7.3"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": "src",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node"
  }
}
